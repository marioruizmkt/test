---
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
}
const { items, title = 'Preguntas *frecuentes*', eyebrow = 'Dudas' } = Astro.props;
import { emph } from '@/lib/text';
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-title" set:html={emph(title)} />
      <p class="faq__more">¿No encuentras la tuya? <a class="link" href="/contacto/">Pregúntanos directamente</a>.</p>
    </div>
    <div class="faq__list">
      {items.map((f, i) => (
        <details class="faq__item" data-reveal style={`--d:${i}`}>
          <summary>
            <span>{f.q}</span>
            <span class="faq__icon"><Icon name="plus" size={18} /></span>
          </summary>
          <div class="faq__answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: 3rem;
  }
  .faq__head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .faq__head h2 {
    font-size: var(--fs-xl);
  }
  .faq__more {
    color: var(--muted);
  }
  .faq__more a {
    color: var(--fg);
    font-weight: 550;
  }
  .faq__list {
    border-top: 1px solid var(--line-strong);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }
  .faq__item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    font-size: var(--fs-md);
    font-weight: 540;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: transform 0.4s var(--ease), background-color 0.3s;
  }
  .faq__item summary:hover .faq__icon {
    background: var(--green);
    box-shadow: none;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }
  .faq__answer {
    padding: 0 3.5rem 1.75rem 0;
    color: var(--muted);
    max-width: 60ch;
  }
  .faq__item[open] .faq__answer {
    animation: faqIn 0.45s var(--ease);
  }
  @keyframes faqIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
    }
    .faq__head {
      position: sticky;
      top: 7rem;
    }
  }
</style>
