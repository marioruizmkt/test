---
import type { Faq } from '@/data/services';

interface Props {
  faqs: Faq[];
  title?: string;
  intro?: string;
}
const { faqs, title = 'Preguntas <em>frecuentes</em>', intro } = Astro.props;
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <p class="eyebrow" data-reveal>Dudas habituales</p>
      <h2 id="faq-title" data-reveal style="--d:1" set:html={title} />
      {intro && <p class="lead" data-reveal style="--d:2">{intro}</p>}
      <p class="faq__more" data-reveal style="--d:3">
        ¿Tienes otra pregunta? <a href="/contacto/" class="link">Escríbenos</a>
      </p>
    </div>
    <div class="faq__list" data-reveal style="--d:1">
      {
        faqs.map((f) => (
          <details class="faq__item" name="faq">
            <summary>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: 48px;
  }
  .faq__head {
    display: grid;
    align-content: start;
    gap: 24px;
    justify-items: start;
  }
  .faq__more {
    color: var(--text-muted);
  }
  .faq__more a {
    color: var(--ink);
    font-weight: 550;
  }
  .faq__list {
    border-top: 1px solid var(--line-strong);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0;
    list-style: none;
    cursor: pointer;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.4rem);
    font-weight: 540;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      background-color 0.3s,
      border-color 0.3s,
      transform 0.5s var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.6px;
    margin: -0.8px 0 0 -7px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.5s var(--ease-out);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item summary:hover .faq__icon {
    background: var(--green);
    border-color: var(--green);
  }
  .faq__item[open] .faq__icon {
    background: var(--ink);
    border-color: var(--ink);
    transform: rotate(180deg);
  }
  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: var(--green);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__answer {
    padding: 0 64px 28px 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 64ch;
  }
  .faq__item[open] .faq__answer {
    animation: faq-in 0.6s var(--ease-out);
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (min-width: 960px) {
    .faq__grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }
</style>
