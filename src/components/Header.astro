---
import LogoLight from '@/assets/brand/logo-light-bg.svg';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site, mainNav } from '@/data/site';
import { pillars, servicesByPillar, childrenOf, serviceHref, serviceNumber, type PillarId } from '@/data/services';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const pillarIds = Object.keys(pillars) as PillarId[];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name}, ir al inicio`}>
      <LogoLight width={148} height={52} aria-hidden="true" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list" class="nav__list">
        <li class="has-mega" data-mega>
          <a href="/servicios/" class="nav__link" aria-current={isCurrent('/servicios/') ? 'page' : undefined}>Servicios</a>
          <button class="mega-toggle" aria-expanded="false" aria-controls="mega-servicios" data-mega-toggle>
            <span class="sr-only">Mostrar servicios</span>
            <Icon name="chevron-down" size={16} />
          </button>
          <div class="mega" id="mega-servicios">
            <div class="mega__inner">
              {
                pillarIds.map((id) => (
                  <div class="mega__col">
                    <p class="mega__pillar">{pillars[id].label}</p>
                    <ul role="list">
                      {servicesByPillar(id).map((s) => (
                        <li>
                          <a href={serviceHref(s.slug)} class="mega__item">
                            <span class="mega__num">{serviceNumber(s.slug)}</span>
                            <span>
                              <span class="mega__name">{s.name}</span>
                              <span class="mega__sum">{s.summary}</span>
                            </span>
                          </a>
                          {childrenOf(s.slug).map((c) => (
                            <a href={serviceHref(c.slug)} class="mega__child">
                              <Icon name="arrow-right" size={14} />
                              {c.name}
                            </a>
                          ))}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
              <a href="/contacto/" class="mega__card">
                <span class="mega__card-label">¿No sabes por dónde empezar?</span>
                <span class="mega__card-title">Cuéntanos tu caso y te diremos qué haríamos primero.</span>
                <span class="mega__card-cta">Hablemos <Icon name="arrow-right" size={16} /></span>
              </a>
            </div>
          </div>
        </li>
        {
          mainNav
            .filter((i) => i.href !== '/servicios/')
            .map((item) => (
              <li>
                <a href={item.href} class="nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a href={site.contact.phoneHref} class="phone">
        <Icon name="phone" size={18} />
        <span>{site.contact.phone}</span>
      </a>
      <Button href="/contacto/" variant="green" class="header-cta">Hablemos</Button>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-toggle__label">Menú</span>
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <div class="mobile-menu__inner container">
      <nav aria-label="Menú móvil">
        <ul role="list" class="mobile-menu__list">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Inicio</a></li>
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.href === '/servicios/' && (
                  <ul role="list" class="mobile-menu__sub">
                    {pillarIds.flatMap((id) =>
                      servicesByPillar(id).flatMap((s) => [
                        <li>
                          <a href={serviceHref(s.slug)}>{s.name}</a>
                        </li>,
                        ...childrenOf(s.slug).map((c) => (
                          <li class="is-child">
                            <a href={serviceHref(c.slug)}>{c.name}</a>
                          </li>
                        )),
                      ]),
                    )}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mobile-menu__foot">
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a href={site.contact.phoneHref}>{site.contact.phone}</a>
        <Button href="/contacto/" variant="green">Cuéntanos tu caso</Button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.4s,
      box-shadow 0.4s;
  }
  .site-header[data-scrolled] {
    background: rgb(242 239 233 / 0.82);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header[data-hidden]:not(:focus-within) {
    transform: translateY(-110%);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }
  .brand {
    display: block;
    flex: none;
    width: clamp(120px, 11vw, 148px);
    margin-top: -6px;
  }
  .brand :global(svg) {
    width: 100%;
    height: auto;
  }

  /* Navegación */
  .nav {
    display: none;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav__list > li {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav__link {
    position: relative;
    padding: 10px 14px;
    border-radius: 999px;
    font-weight: 520;
    font-size: 0.98rem;
    transition: background-color 0.3s;
  }
  .nav__link:hover {
    background: rgb(20 23 20 / 0.06);
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--green);
  }
  .mega-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: -10px;
    border-radius: 50%;
    transition: transform 0.4s var(--ease-out);
  }
  .has-mega.is-open .mega-toggle,
  .has-mega:hover .mega-toggle {
    transform: rotate(180deg);
  }

  .mega {
    position: fixed;
    top: calc(var(--header-h) - 8px);
    left: 50%;
    width: min(1180px, calc(100vw - 2 * var(--gutter)));
    transform: translate(-50%, 10px);
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-out),
      visibility 0s 0.3s;
  }
  .has-mega:hover .mega,
  .has-mega.is-open .mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-out),
      visibility 0s;
  }
  .mega__inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 0.9fr;
    gap: 8px;
    padding: 10px;
    border-radius: var(--r-l);
    background: var(--white);
    box-shadow:
      0 1px 0 var(--line),
      0 30px 80px -20px rgb(20 23 20 / 0.28);
  }
  .mega__col {
    padding: 20px 14px 14px;
  }
  .mega__pillar {
    padding: 0 10px 12px;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .mega__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 12px 10px;
    border-radius: var(--r-s);
    transition: background-color 0.25s;
  }
  .mega__item:hover {
    background: var(--paper);
  }
  .mega__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--green-ink);
    line-height: 1.3;
  }
  .mega__name {
    display: block;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .mega__sum {
    display: block;
    margin-top: 3px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
  .mega__child {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: -2px 0 6px 40px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 550;
    width: fit-content;
    background: var(--paper);
    transition: background-color 0.25s;
  }
  .mega__child:hover {
    background: var(--green);
  }
  .mega__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    border-radius: calc(var(--r-l) - 8px);
    background: var(--ink);
    color: var(--paper);
    transition: background-color 0.3s;
  }
  .mega__card:hover {
    background: var(--ink-3);
  }
  .mega__card-label {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 600;
  }
  .mega__card-title {
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 520;
  }
  .mega__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    font-weight: 600;
  }

  /* Acciones */
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .phone {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    font-size: 0.95rem;
    font-weight: 520;
    font-variant-numeric: tabular-nums;
  }
  .header-cta {
    display: none;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 46px;
    padding: 0 8px 0 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .menu-toggle__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--green);
  }
  .menu-toggle__icon i {
    position: absolute;
    width: 14px;
    height: 1.7px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.45s var(--ease-out);
  }
  .menu-toggle__icon i:first-child {
    transform: translateY(-3px);
  }
  .menu-toggle__icon i:last-child {
    transform: translateY(3px);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:first-child {
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:last-child {
    transform: rotate(-45deg);
  }

  /* Menú móvil */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: -1;
    background: var(--paper);
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.7s var(--ease-out),
      visibility 0s 0.7s;
  }
  .site-header.menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.7s var(--ease-out),
      visibility 0s;
  }
  .site-header.menu-open {
    background: var(--paper);
  }
  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 100%;
    padding-block: 24px 32px;
  }
  .mobile-menu__list > li {
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu__list > li > a {
    display: block;
    padding: 14px 0;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 540;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .mobile-menu__list a[aria-current='page'] {
    color: var(--green-ink);
  }
  .mobile-menu__sub {
    display: grid;
    gap: 2px;
    padding: 0 0 18px;
  }
  .mobile-menu__sub a {
    display: block;
    padding: 6px 0;
    font-size: 1.08rem;
    color: var(--text-muted);
  }
  .mobile-menu__sub .is-child a {
    padding-left: 18px;
  }
  .mobile-menu__foot {
    display: grid;
    gap: 10px;
    font-weight: 520;
  }
  .mobile-menu__foot :global(.btn) {
    margin-top: 12px;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    .phone {
      display: inline-flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Estado al hacer scroll: fondo y ocultación al bajar.
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.toggleAttribute('data-scrolled', y > 8);
      const menuOpen = header.classList.contains('menu-open');
      if (!menuOpen) header.toggleAttribute('data-hidden', y > 480 && y > lastY + 2);
      if (y < lastY - 2) header.removeAttribute('data-hidden');
      lastY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mega menú (teclado y táctil)
    const mega = header.querySelector<HTMLElement>('[data-mega]');
    const megaToggle = header.querySelector<HTMLButtonElement>('[data-mega-toggle]');
    const setMega = (open: boolean) => {
      mega?.classList.toggle('is-open', open);
      megaToggle?.setAttribute('aria-expanded', String(open));
    };
    megaToggle?.addEventListener('click', () => setMega(!mega?.classList.contains('is-open')));
    mega?.addEventListener('focusout', (e) => {
      if (!mega.contains(e.relatedTarget as Node)) setMega(false);
    });

    // Menú móvil
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const setMenu = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      menuToggle?.setAttribute('aria-expanded', String(open));
      const label = menuToggle?.querySelector('.menu-toggle__label');
      if (label) label.textContent = open ? 'Cerrar' : 'Menú';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) header.removeAttribute('data-hidden');
    };
    menuToggle?.addEventListener('click', () => setMenu(!header.classList.contains('menu-open')));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (mega?.classList.contains('is-open')) {
        setMega(false);
        megaToggle?.focus();
      }
      if (header.classList.contains('menu-open')) {
        setMenu(false);
        menuToggle?.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setMenu(false));
  }
</script>
