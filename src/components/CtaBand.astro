---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '@/data/site';
import cafe from '@/assets/images/contacto.jpg';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Hablemos de tu negocio. <em>Sin compromiso.</em>',
  text = 'Una conversación de 30 minutos para entender dónde estás, qué te frena y qué haríamos primero. Si no podemos ayudarte, también te lo diremos.',
} = Astro.props;
---

<section class="cta-band section-s" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-band__box">
      <div class="cta-band__copy">
        <p class="eyebrow" data-reveal>Primer paso</p>
        <h2 id="cta-title" data-reveal style="--d:1" set:html={title} />
        <p class="cta-band__text" data-reveal style="--d:2">{text}</p>
        <div class="cta-band__actions" data-reveal style="--d:3">
          <Button href="/contacto/" variant="green">Cuéntanos tu caso</Button>
          <Button href={site.contact.whatsapp} variant="ghost" external>
            <Icon name="whatsapp" size={18} /> Escríbenos por WhatsApp
          </Button>
        </div>
        <p class="cta-band__note" data-reveal style="--d:4">
          <Icon name="clock" size={16} />
          {site.contact.responseTime}
        </p>
      </div>
      <div class="cta-band__media" data-reveal="img" style="--d:1">
        <Image src={cafe} alt="Mesa de café en una terraza al sol, con dos tazas y una libreta abierta." widths={[480, 760, 1100]} sizes="(min-width: 960px) 40vw, 100vw" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band__box {
    display: grid;
    gap: 40px;
    padding: clamp(28px, 5vw, 72px);
    border-radius: var(--r-xl);
    background: var(--green);
    color: var(--ink);
    overflow: hidden;
  }
  .cta-band__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
  }
  .cta-band .eyebrow {
    border-color: rgb(20 23 20 / 0.3);
  }
  .cta-band .eyebrow::before {
    background: var(--ink);
    box-shadow: none;
  }
  .cta-band h2 {
    max-width: 14ch;
  }
  .cta-band__text {
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cta-band__actions :global(.btn--green) {
    --btn-bg: var(--ink);
    --btn-fg: var(--paper);
    --btn-hover-bg: var(--paper);
    --btn-hover-fg: var(--ink);
  }
  .cta-band__actions :global(.btn--green .btn__icon) {
    background: var(--green);
    color: var(--ink);
  }
  .cta-band__actions :global(.btn--ghost) {
    box-shadow: inset 0 0 0 1px rgb(20 23 20 / 0.35);
  }
  .cta-band__note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: 550;
  }
  .cta-band__media {
    border-radius: var(--r-l);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: 640px;
  }
  .cta-band__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 960px) {
    .cta-band__box {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 64px;
    }
    .cta-band__media {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }
  @media (max-width: 959px) {
    .cta-band__media {
      aspect-ratio: 16 / 11;
    }
  }
</style>
