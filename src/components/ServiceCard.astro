---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { serviceHref, type Service } from '@/data/services';

interface Props {
  service: Service;
  index?: number;
  size?: 'lg' | 'md';
  class?: string;
}
const { service: s, index, size = 'md', class: className } = Astro.props;
---

<a href={serviceHref(s)} class:list={['scard', `scard--${size}`, className]} data-reveal style={index !== undefined ? `--d:${index % 3}` : undefined}>
  <div class="scard__top">
    <span class="scard__stage mono">{s.stage}</span>
    <span class="scard__arrow"><Icon name="arrow-up-right" size={18} /></span>
  </div>
  <div class="scard__art">
    <Image src={s.image} alt={s.imageAlt} widths={[240, 400, 560]} sizes={size === 'lg' ? '(min-width: 900px) 30vw, 70vw' : '(min-width: 900px) 18vw, 50vw'} loading="lazy" />
  </div>
  <div class="scard__body">
    <h3>{s.name}</h3>
    <p>{s.card.text}</p>
  </div>
</a>

<style>
  .scard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    min-height: 26rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: 0 1px 0 var(--line);
    overflow: hidden;
    transition: background-color 0.5s var(--ease), transform 0.6s var(--ease), box-shadow 0.5s var(--ease);
  }
  .scard:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -30px rgb(20 23 20 / 0.35);
  }
  .scard__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .scard__stage {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--paper);
    text-transform: uppercase;
    font-size: 0.6875rem;
  }
  .scard__arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: background-color 0.3s, transform 0.5s var(--ease-spring), box-shadow 0.3s;
  }
  .scard:hover .scard__arrow {
    background: var(--green);
    box-shadow: none;
    transform: rotate(45deg);
  }
  .scard__art {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0.5rem 1rem;
  }
  .scard__art :global(img) {
    width: auto;
    max-width: 72%;
    max-height: 11rem;
    object-fit: contain;
    transition: transform 0.8s var(--ease-spring);
  }
  .scard:hover .scard__art :global(img) {
    transform: scale(1.06) rotate(-3deg);
  }
  .scard__body h3 {
    font-size: 1.5rem;
    margin-bottom: 0.4rem;
  }
  .scard__body p {
    color: var(--muted);
    font-size: 0.96875rem;
    line-height: 1.5;
    max-width: 34ch;
  }
  .scard--lg .scard__art :global(img) {
    max-height: 15rem;
  }
  @media (min-width: 1024px) {
    .scard.is-full {
      min-height: 0;
      display: grid;
      grid-template-columns: 1.2fr 1fr auto;
      grid-template-areas: 'body art top';
      align-items: center;
      gap: 2rem;
      padding: 2rem 2rem 2rem 2.5rem;
      background: var(--green);
    }
    .scard.is-full .scard__body {
      grid-area: body;
    }
    .scard.is-full .scard__body h3 {
      font-size: var(--fs-xl);
    }
    .scard.is-full .scard__body p {
      color: var(--ink);
      font-size: var(--fs-md);
    }
    .scard.is-full .scard__art {
      grid-area: art;
      padding: 0;
    }
    .scard.is-full .scard__art :global(img) {
      max-height: 10rem;
    }
    .scard.is-full .scard__top {
      grid-area: top;
      flex-direction: column;
      gap: 1rem;
      align-self: stretch;
      justify-content: space-between;
      align-items: flex-end;
    }
    .scard.is-full .scard__stage {
      background: var(--ink);
      color: var(--green);
    }
    .scard.is-full .scard__arrow {
      background: var(--ink);
      color: var(--green);
      box-shadow: none;
    }
  }
  .scard--lg .scard__body h3 {
    font-size: var(--fs-lg);
  }
</style>
