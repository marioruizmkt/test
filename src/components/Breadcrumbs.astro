---
import type { Crumb } from '@/layouts/BaseLayout.astro';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Migas de pan" class="crumbs">
  <ol role="list">
    <li><a href="/">Inicio</a></li>
    {items.map((c, i) => (
      <li>
        {i === items.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.35rem;
    opacity: 0.5;
  }
  .crumbs a:hover {
    color: var(--fg);
  }
  .crumbs [aria-current] {
    color: var(--fg);
  }
</style>
