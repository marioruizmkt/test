---
/** Se muestra sólo cuando hay testimonios reales en src/data/testimonials.ts. */
import { testimonials } from '@/data/testimonials';
---

{
  testimonials.length > 0 && (
    <section class="section-s quotes" aria-labelledby="quotes-title">
      <div class="container">
        <p class="eyebrow" data-reveal>
          Clientes
        </p>
        <h2 id="quotes-title" class="sr-only">
          Lo que dicen nuestros clientes
        </h2>
        <ul role="list" class="quotes__list">
          {testimonials.map((t, i) => (
            <li class="quote" data-reveal style={`--d:${i % 3}`}>
              <blockquote>
                <p>“{t.quote}”</p>
              </blockquote>
              <p class="quote__by">
                <strong>{t.name}</strong>
                <span>
                  {t.role}, {t.company}
                </span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .quotes__list {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }
  .quote {
    display: grid;
    gap: 24px;
    align-content: space-between;
    padding: 32px;
    border-radius: var(--r-l);
    background: var(--paper-2);
  }
  .quote blockquote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    line-height: 1.2;
  }
  .quote__by {
    display: grid;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .quote__by strong {
    color: var(--ink);
  }
  @media (min-width: 900px) {
    .quotes__list {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }
</style>
