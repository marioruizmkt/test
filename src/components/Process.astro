---
import type { Item } from '@/data/services';

interface Props {
  steps: Item[];
  eyebrow?: string;
  title: string;
  intro?: string;
  dark?: boolean;
}
const { steps, eyebrow = 'Cómo lo hacemos', title, intro, dark = false } = Astro.props;
---

<section class:list={['section process', { 'on-ink': dark }]} aria-labelledby="process-title">
  <div class="container">
    <div class="process__head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 id="process-title" data-reveal style="--d:1" set:html={title} />
      {intro && <p class="lead" data-reveal style="--d:2">{intro}</p>}
    </div>
    <ol role="list" class="process__steps">
      {
        steps.map((s, i) => (
          <li class="process__step" data-reveal style={`--d:${i}`}>
            <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="process__title">{s.title}</h3>
            <p class="process__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__head {
    display: grid;
    gap: 24px;
    justify-items: start;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .process__head h2 {
    max-width: 16ch;
  }
  .process__steps {
    display: grid;
    gap: 16px;
    counter-reset: step;
  }
  .process__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 28px 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .on-ink .process__step {
    border-color: var(--line-on-ink);
  }
  .process__step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--green);
    transition: width 1.4s var(--ease-out);
    transition-delay: calc(var(--d, 0) * 150ms + 200ms);
  }
  .process__step.is-in::before {
    width: 100%;
  }
  .process__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    line-height: 0.9;
    color: var(--green-ink);
  }
  .on-ink .process__num {
    color: var(--green);
  }
  .process__title {
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .process__text {
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 36ch;
  }
  .on-ink .process__text {
    color: var(--text-on-ink-muted);
  }
  @media (min-width: 720px) {
    .process__steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 32px;
    }
  }
  @media (min-width: 1100px) {
    .process__steps {
      grid-template-columns: repeat(4, 1fr);
    }
    .process__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .process__head .eyebrow {
      grid-column: 1 / -1;
    }
  }
</style>
