---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import ServiceRows from '@/components/ServiceRows.astro';
import DependencyTest from '@/components/DependencyTest.astro';
import Process from '@/components/Process.astro';
import Commitments from '@/components/Commitments.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/data/site';
import { pillars, topLevelServices, servicesByPillar, serviceHref, type PillarId } from '@/data/services';
import { faqSchema, webPageSchema } from '@/lib/schema';

import heroImg from '@/assets/images/home-hero.jpg';
import freedomImg from '@/assets/images/libertad.jpg';

const pillarIds = Object.keys(pillars) as PillarId[];

const marquee = ['Diseño web', 'Marketing digital', 'Automatización', 'Inteligencia artificial', 'Software a medida', 'Consultoría'];

const notifications = [
  { title: 'Nuevo pedido online', meta: 'Hace 2 minutos', tone: 'green' },
  { title: 'Factura enviada automáticamente', meta: 'Hoy, 07:42', tone: 'paper' },
  { title: 'Cita confirmada por tu asistente', meta: 'Sábado, 10:30', tone: 'ink' },
];

const chores = ['Contestas el teléfono.', 'Haces los presupuestos.', 'Persigues las facturas.', 'Actualizas la web, cuando puedes.', 'Buscas clientes nuevos.'];

const method = [
  { title: 'Escuchar', text: 'Empezamos por entender tu negocio, tus números y tu día a día. Sin plantillas ni soluciones precocinadas.' },
  { title: 'Priorizar', text: 'Detectamos dónde se pierden clientes y horas, y elegimos las acciones con más retorno para empezar.' },
  { title: 'Construir', text: 'Diseñamos, desarrollamos e implantamos con entregas frecuentes para que veas avances reales.' },
  { title: 'Acompañar', text: 'Medimos resultados, formamos a tu equipo y seguimos mejorando contigo.' },
];

const faqs = [
  {
    q: '¿Con qué tipo de empresas trabajáis?',
    a: 'Con pequeñas y medianas empresas, autónomos con equipo y negocios familiares que quieren crecer sin que todo pase por la persona que los dirige: comercios, despachos, clínicas, talleres, industria, hostelería, servicios profesionales…',
  },
  {
    q: '¿Cuánto cuesta trabajar con vosotros?',
    a: 'Depende de lo que necesites. Tras la primera conversación te enviamos una propuesta con alcance, plazos y un presupuesto cerrado por escrito. Sin letra pequeña.',
  },
  {
    q: '¿Puedo contrataros sólo un servicio?',
    a: 'Claro. Puedes empezar por una web, una automatización o un diagnóstico. La ventaja de tenerlo todo bajo el mismo techo es que, cuando quieras dar el siguiente paso, todo encaja.',
  },
  {
    q: '¿Trabajáis con empresas de toda España?',
    a: 'Sí. Trabajamos en remoto con reuniones por videollamada y, cuando el proyecto lo pide, nos desplazamos para conocer tu negocio en persona.',
  },
  {
    q: '¿Qué pasa en la primera conversación?',
    a: 'Nos cuentas tu situación, te hacemos preguntas y te decimos con franqueza qué haríamos primero. Dura unos 30 minutos y no te compromete a nada.',
  },
];

const description =
  'Agencia digital para pymes. Diseño web, marketing, automatización, inteligencia artificial y software a medida para que tu negocio venda más y dependa menos de ti.';
---

<Base
  title={`${site.name} · Agencia digital para pymes que quieren vender más y depender menos de ti`}
  rawTitle
  description={description}
  schema={[webPageSchema({ name: site.name, description, href: '/' }), faqSchema(faqs)]}
>
  <!-- ——— Hero ——— -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal>Agencia digital para pymes</p>
        <h1 class="h-display hero__title" data-reveal style="--d:1">
          Que tu negocio venda <em>más</em> y dependa <em>menos de ti.</em>
        </h1>
        <p class="lead hero__lead" data-reveal style="--d:2">
          Webs que consiguen clientes, procesos que funcionan solos e inteligencia artificial con sentido común. Todo
          lo digital de tu empresa, con un solo equipo.
        </p>
        <div class="hero__actions" data-reveal style="--d:3">
          <Button href="/contacto/" variant="green">Cuéntanos tu caso</Button>
          <Button href="#test" variant="ghost">Haz el test de 1 minuto</Button>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__media" data-reveal="img" style="--d:1">
          <Image
            src={heroImg}
            alt="Propietaria de un taller de cerámica toma un café en su estudio mientras los pedidos esperan listos para enviar."
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <ul role="list" class="hero__notes" aria-label="Ejemplos de lo que ocurre mientras no estás">
          {
            notifications.map((n, i) => (
              <li class={`note note--${n.tone}`} style={`--i:${i}`}>
                <span class="note__dot" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
                <span>
                  <span class="note__title">{n.title}</span>
                  <span class="note__meta">{n.meta}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ——— Cinta de servicios ——— -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <div class="marquee__group">
            {marquee.map((m) => (
              <span class="marquee__item">
                {m}
                <svg viewBox="0 0 24 24" class="marquee__mark">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" />
                </svg>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- ——— El problema ——— -->
  <section class="section problem" aria-labelledby="problem-title">
    <div class="container problem__grid">
      <div class="problem__head">
        <p class="eyebrow" data-reveal>Te suena, ¿verdad?</p>
        <h2 id="problem-title" data-reveal style="--d:1">
          Tienes un buen negocio. El problema es que <em>todo pasa por ti.</em>
        </h2>
      </div>
      <div class="problem__body">
        <ul role="list" class="chores">
          {
            chores.map((c, i) => (
              <li class="chore" data-reveal style={`--d:${i}`}>
                {c}
              </li>
            ))
          }
          <li class="chore chore--last" data-reveal style="--d:5">Y, además, haces tu trabajo.</li>
        </ul>
        <p class="problem__answer" data-reveal>
          Nuestro trabajo es que dejes de ser el cuello de botella de tu propia empresa: que los clientes lleguen solos,
          que las tareas repetitivas se hagan sin ti y que tengas tiempo para pensar en lo importante.
        </p>
      </div>
    </div>
  </section>

  <!-- ——— Servicios ——— -->
  <section class="section-s services" aria-labelledby="services-title">
    <div class="container">
      <div class="services__head">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h2 id="services-title" data-reveal style="--d:1">Tres palancas. <em>Un mismo objetivo.</em></h2>
      </div>
      <div class="pillars">
        {
          pillarIds.map((id, i) => (
            <article class="pillar" data-reveal style={`--d:${i}`}>
              <p class="pillar__label">
                <span>{String(i + 1).padStart(2, '0')}</span>
                {pillars[id].label}
              </p>
              <h3>{pillars[id].title}</h3>
              <p class="pillar__text">{pillars[id].text}</p>
              <ul role="list" class="pillar__links">
                {servicesByPillar(id).map((s) => (
                  <li>
                    <a href={serviceHref(s.slug)}>{s.name}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <ServiceRows items={topLevelServices} />
      <div class="services__more" data-reveal>
        <Button href="/servicios/" variant="ghost">Ver todos los servicios</Button>
      </div>
    </div>
  </section>

  <!-- ——— Test ——— -->
  <div id="test">
    <DependencyTest />
  </div>

  <!-- ——— Manifiesto ——— -->
  <section class="freedom" aria-labelledby="freedom-title">
    <div class="container">
      <figure class="freedom__figure" data-reveal="img">
        <Image
          src={freedomImg}
          alt="Un hombre pasea con su perro por un paseo marítimo a primera hora de la mañana."
          widths={[640, 1024, 1440, 2048]}
          sizes="100vw"
        />
        <figcaption class="freedom__caption">
          <h2 id="freedom-title" class="freedom__quote">
            El objetivo no es que trabajes más horas en tu negocio. <em>Es que tu negocio trabaje más horas por ti.</em>
          </h2>
        </figcaption>
      </figure>
    </div>
  </section>

  <Process
    title="Un método claro, <em>de principio a fin.</em>"
    intro="Sin jerga, sin sorpresas y sin proyectos eternos. Así trabajamos en cada proyecto, sea grande o pequeño."
    steps={method}
  />

  <Commitments />
  <Testimonials />

  <Faq faqs={faqs} />
  <CtaBand />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    padding-top: calc(var(--header-h) + clamp(32px, 5vw, 72px));
    padding-bottom: clamp(48px, 6vw, 96px);
  }
  .hero__grid {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .hero__title {
    isolation: isolate;
  }
  .hero__title em:last-child {
    position: relative;
    white-space: nowrap;
  }
  .hero__title em:last-child::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.08em;
    bottom: 0.06em;
    height: 0.14em;
    background: var(--green);
    border-radius: 999px;
    z-index: -1;
    transform-origin: left;
    animation: underline 1.2s 0.9s var(--ease-out) both;
  }
  @keyframes underline {
    from {
      transform: scaleX(0);
    }
  }
  .hero__lead {
    max-width: 44ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero__visual {
    position: relative;
    max-width: 620px;
    width: 100%;
    justify-self: center;
  }
  .hero__media {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-l);
    overflow: hidden;
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__notes {
    position: absolute;
    left: clamp(-56px, -4vw, -12px);
    bottom: 8%;
    display: grid;
    gap: 10px;
    width: min(330px, 86%);
  }
  .note {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px 14px 14px;
    border-radius: 18px 18px 18px 6px;
    background: var(--white);
    box-shadow:
      0 1px 0 var(--line),
      0 20px 40px -18px rgb(20 23 20 / 0.35);
    animation:
      note-in 0.9s var(--ease-out) both,
      note-float 6s ease-in-out infinite;
    animation-delay: calc(1.1s + var(--i) * 0.45s), calc(2s + var(--i) * 0.8s);
  }
  .note:nth-child(2) {
    margin-left: 28px;
  }
  .note:nth-child(3) {
    margin-left: 8px;
  }
  .note--ink {
    background: var(--ink);
    color: var(--paper);
  }
  .note__dot {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--green);
    color: var(--ink);
  }
  .note__title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .note__meta {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .note--ink .note__meta {
    color: var(--text-on-ink-muted);
  }
  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
    }
  }
  @keyframes note-float {
    50% {
      transform: translateY(-6px);
    }
  }
  @media (min-width: 1024px) {
    .hero {
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
    .hero__grid {
      grid-template-columns: 1.25fr 0.75fr;
    }
    .hero__visual {
      justify-self: end;
    }
  }
  @media (max-width: 600px) {
    .hero__notes {
      left: 12px;
      bottom: 12px;
      width: calc(100% - 24px);
    }
    .note:nth-child(2),
    .note:nth-child(3) {
      margin-left: 0;
    }
  }

  /* ——— Marquee ——— */
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line-strong);
    padding-block: 22px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__group {
    display: flex;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 36px;
    padding-right: 36px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.8rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .marquee__item:nth-child(even) {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .marquee__mark {
    width: 0.8em;
    height: 0.8em;
    fill: none;
    stroke: var(--green-ink);
    stroke-width: 1.6;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ——— Problema ——— */
  .problem__grid {
    display: grid;
    gap: 48px;
  }
  .problem__head {
    display: grid;
    gap: 24px;
    justify-items: start;
    align-content: start;
  }
  .problem__head h2 {
    max-width: 14ch;
  }
  .chores {
    border-top: 1px solid var(--line-strong);
  }
  .chore {
    position: relative;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--text-muted);
  }
  .chore:not(.chore--last)::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    height: 3px;
    width: 0;
    background: var(--green);
    border-radius: 3px;
    transition: width 1.1s var(--ease-out);
    transition-delay: calc(var(--d) * 120ms + 600ms);
  }
  .chore.is-in::after {
    width: min(100%, var(--w, 14ch));
  }
  .chore--last {
    color: var(--ink);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    font-size: clamp(1.7rem, 1.3rem + 1.8vw, 3rem);
    border-bottom: 0;
    padding-top: 26px;
  }
  .problem__answer {
    margin-top: 40px;
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: -0.012em;
  }
  @media (min-width: 1024px) {
    .problem__grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
    .problem__head {
      position: sticky;
      top: calc(var(--header-h) + 40px);
      align-self: start;
    }
  }

  /* ——— Servicios ——— */
  .services__head {
    display: grid;
    gap: 24px;
    justify-items: start;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .pillars {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(56px, 7vw, 104px);
  }
  .pillar {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--r-l);
    background: var(--paper-2);
    transition:
      background-color 0.4s,
      transform 0.6s var(--ease-out);
  }
  .pillar:hover {
    background: var(--white);
  }
  .pillar__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pillar__label span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--green);
    font-size: 0.72rem;
    letter-spacing: 0;
  }
  .pillar h3 {
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.95rem);
    max-width: 16ch;
  }
  .pillar__text {
    color: var(--text-muted);
    line-height: 1.55;
  }
  .pillar__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .pillar__links a {
    display: inline-block;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.88rem;
    font-weight: 550;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .pillar__links a:hover {
    background: var(--green);
    border-color: var(--green);
  }
  .services__more {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ——— Libertad ——— */
  .freedom {
    padding-block: var(--section-s) 0;
  }
  .freedom__figure {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    min-height: clamp(520px, 72vw, 860px);
    display: flex;
    align-items: flex-end;
  }
  .freedom__figure :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }
  .freedom__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 23 20 / 0) 30%, rgb(20 23 20 / 0.72) 100%);
  }
  .freedom__caption {
    position: relative;
    z-index: 1;
    padding: clamp(28px, 5vw, 72px);
  }
  .freedom__quote {
    max-width: 22ch;
    color: var(--paper);
    font-size: clamp(1.9rem, 1.2rem + 3vw, 4.4rem);
    line-height: 1.02;
  }
  .freedom__quote em {
    color: var(--green);
  }
</style>

<script>
  // Ajusta el tachado verde a la anchura real de cada frase.
  document.querySelectorAll<HTMLElement>('.chore:not(.chore--last)').forEach((el) => {
    const range = document.createRange();
    range.selectNodeContents(el);
    const w = range.getBoundingClientRect().width;
    el.style.setProperty('--w', `${Math.ceil(w)}px`);
  });
</script>
