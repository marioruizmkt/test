---
/**
 * Plantilla de servicio. Genera una página por cada entrada de
 * src/data/services.ts, incluidos los subservicios (p. ej. software/a-medida).
 */
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Process from '@/components/Process.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import {
  services,
  pillars,
  getService,
  childrenOf,
  serviceHref,
  serviceNumber,
  type Service,
} from '@/data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

interface Props {
  service: Service;
}
const { service: s } = Astro.props;

const parent = s.parent ? getService(s.parent) : undefined;
const children = childrenOf(s.slug);
const related = s.related.map((slug) => getService(slug)).filter((x): x is Service => Boolean(x));
const href = serviceHref(s.slug);

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios/' },
  ...(parent ? [{ label: parent.name, href: serviceHref(parent.slug) }] : []),
  { label: s.name, href },
];
---

<Base
  title={s.seoTitle}
  description={s.description}
  schema={[serviceSchema({ name: s.name, description: s.description, href }), breadcrumbSchema(crumbs), faqSchema(s.faqs)]}
>
  <!-- ——— Hero ——— -->
  <section class="s-hero">
    <div class="container s-hero__grid">
      <div class="s-hero__copy">
        <div data-reveal><Breadcrumbs items={crumbs} /></div>
        <p class="eyebrow" data-reveal style="--d:1">
          {serviceNumber(s.slug)} · {pillars[s.pillar].label}
        </p>
        <h1 data-reveal style="--d:2" set:html={s.title} />
        <p class="lead" data-reveal style="--d:3">{s.lead}</p>
        <div class="s-hero__actions" data-reveal style="--d:4">
          <Button href={`/contacto/?interes=${encodeURIComponent(s.slug)}`} variant="green">Pide tu propuesta</Button>
          <Button href="#incluye" variant="ghost">Qué incluye</Button>
        </div>
        <ul role="list" class="s-hero__tags" data-reveal style="--d:5" aria-label="Áreas del servicio">
          {s.tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="s-hero__media" data-reveal="img" style="--d:1">
        <Image
          src={s.image}
          alt={s.imageAlt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <span class="s-hero__badge">{s.name}</span>
      </div>
    </div>
  </section>

  <!-- ——— Para quién ——— -->
  <section class="section-s fit" aria-labelledby="fit-title">
    <div class="container fit__grid">
      <div class="fit__head">
        <p class="eyebrow" data-reveal>¿Es para ti?</p>
        <h2 id="fit-title" data-reveal style="--d:1">Es para ti <em>si…</em></h2>
      </div>
      <ul role="list" class="fit__list">
        {
          s.forYouIf.map((t, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="fit__check" aria-hidden="true">
                <Icon name="check" size={18} />
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ——— Resultados ——— -->
  <section class="section outcomes on-ink" aria-labelledby="outcomes-title">
    <div class="container">
      <div class="outcomes__head">
        <p class="eyebrow" data-reveal>Lo que vas a conseguir</p>
        <h2 id="outcomes-title" data-reveal style="--d:1">Resultados que <em>se notan</em> en tu día a día.</h2>
      </div>
      <ol role="list" class="outcomes__list">
        {
          s.outcomes.map((o, i) => (
            <li class="outcome" data-reveal style={`--d:${i}`}>
              <span class="outcome__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ——— Qué incluye ——— -->
  <section class="section includes" id="incluye" aria-labelledby="includes-title">
    <div class="container">
      <div class="includes__head">
        <p class="eyebrow" data-reveal>Qué incluye</p>
        <h2 id="includes-title" data-reveal style="--d:1">Todo lo necesario, <em>nada de relleno.</em></h2>
        <p class="lead" data-reveal style="--d:2">
          Adaptamos el alcance a tu negocio, pero esto es lo que suele formar parte de un proyecto de {s.name.toLowerCase()}.
        </p>
      </div>
      <ul role="list" class="includes__grid">
        {
          s.includes.map((it, i) => (
            <li class="include" data-reveal style={`--d:${i % 3}`}>
              <span class="include__icon" aria-hidden="true">
                <Icon name="plus" size={18} />
              </span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ——— Especialidades (subservicios) ——— -->
  {
    children.length > 0 && (
      <section class="section-s specialties" aria-labelledby="spec-title">
        <div class="container">
          <p class="eyebrow" data-reveal>
            Especialidades
          </p>
          <h2 id="spec-title" class="sr-only">
            Especialidades de {s.name}
          </h2>
          <ul role="list" class="specialties__list">
            {children.map((c) => (
              <li data-reveal style="--d:1">
                <a href={serviceHref(c.slug)} class="spec">
                  <div class="spec__media">
                    <Image src={c.image} alt="" widths={[480, 720, 960]} sizes="(min-width: 900px) 40vw, 100vw" />
                  </div>
                  <div class="spec__body">
                    <h3 set:html={c.title} />
                    <p>{c.summary}</p>
                    <span class="spec__cta">
                      Descubre {c.name.toLowerCase()} <Icon name="arrow-right" size={18} />
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    parent && (
      <div class="container back">
        <a href={serviceHref(parent.slug)} class="back__link">
          <Icon name="arrow-right" size={16} class="back__icon" />
          Parte de nuestro servicio de <strong>{parent.name}</strong>
        </a>
      </div>
    )
  }

  <Process
    dark={false}
    eyebrow="Cómo trabajamos"
    title="Paso a paso, <em>sin sorpresas.</em>"
    intro="Fases claras, entregas frecuentes y una persona de referencia que te acompaña de principio a fin."
    steps={s.process}
  />

  <Faq faqs={s.faqs} />

  <!-- ——— Relacionados ——— -->
  <section class="section-s related" aria-labelledby="related-title">
    <div class="container">
      <div class="related__head">
        <h2 id="related-title" data-reveal>Encaja muy bien <em>con…</em></h2>
        <a href="/servicios/" class="link" data-reveal>Ver todos los servicios</a>
      </div>
      <ul role="list" class="related__grid">
        {
          related.map((r, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a href={serviceHref(r.slug)} class="card">
                <div class="card__media">
                  <Image src={r.image} alt="" widths={[400, 640, 800]} sizes="(min-width: 900px) 30vw, 100vw" />
                </div>
                <div class="card__body">
                  <span class="card__num">{serviceNumber(r.slug)}</span>
                  <h3>{r.name}</h3>
                  <p>{r.summary}</p>
                </div>
                <span class="card__arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={20} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title={`¿Hablamos de tu proyecto de <em>${s.name.toLowerCase()}</em>?`}
    text="Cuéntanos qué necesitas y en menos de 24 horas laborables te proponemos una primera conversación. Sin compromiso y sin tecnicismos."
  />
</Base>

<style>
  /* Hero */
  .s-hero {
    padding-top: calc(var(--header-h) + clamp(24px, 4vw, 56px));
    padding-bottom: var(--section-s);
  }
  .s-hero__grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .s-hero__copy {
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .s-hero__copy h1 {
    max-width: 14ch;
  }
  .s-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .s-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .s-hero__tags li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 0.85rem;
    font-weight: 520;
    color: var(--text-muted);
  }
  .s-hero__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-l);
    overflow: hidden;
    max-width: 600px;
    width: 100%;
    justify-self: center;
  }
  .s-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .s-hero__badge {
    position: absolute;
    left: 18px;
    bottom: 18px;
    padding: 10px 16px;
    border-radius: 999px 999px 999px 4px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .s-hero__grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 72px;
    }
    .s-hero__media {
      justify-self: end;
    }
  }

  /* Para quién */
  .fit__grid {
    display: grid;
    gap: 40px;
  }
  .fit__head {
    display: grid;
    gap: 24px;
    justify-items: start;
    align-content: start;
  }
  .fit__list {
    border-top: 1px solid var(--line-strong);
  }
  .fit__list li {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-strong);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .fit__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--green);
  }
  @media (min-width: 960px) {
    .fit__grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
  }

  /* Resultados */
  .outcomes {
    border-radius: var(--r-xl);
    margin-inline: clamp(0px, 1vw, 16px);
  }
  .outcomes__head {
    display: grid;
    gap: 24px;
    justify-items: start;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .outcomes__head h2 {
    max-width: 16ch;
  }
  .outcomes__head h2 em {
    color: var(--green);
  }
  .outcomes__list {
    display: grid;
    gap: 12px;
  }
  .outcome {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--r-l);
    background: var(--ink-2);
    border: 1px solid var(--line-on-ink);
    transition:
      background-color 0.4s,
      transform 0.6s var(--ease-out);
  }
  .outcome:hover {
    background: var(--ink-3);
  }
  .outcome__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3.2rem, 2rem + 3vw, 5.5rem);
    line-height: 0.9;
    color: var(--green);
    margin-bottom: clamp(24px, 4vw, 56px);
  }
  .outcome h3 {
    font-size: var(--fs-h3);
  }
  .outcome p {
    color: var(--text-on-ink-muted);
    line-height: 1.6;
  }
  @media (min-width: 900px) {
    .outcomes__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Incluye */
  .includes__head {
    display: grid;
    gap: 24px;
    justify-items: start;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .includes__head h2 {
    max-width: 15ch;
  }
  .includes__grid {
    display: grid;
    gap: 12px;
  }
  .include {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px;
    border-radius: var(--r-m);
    background: var(--paper-2);
    transition: background-color 0.35s;
  }
  .include:hover {
    background: var(--white);
  }
  .include__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px 12px 12px 4px;
    background: var(--ink);
    color: var(--green);
    margin-bottom: 10px;
    transition: transform 0.6s var(--ease-out);
  }
  .include:hover .include__icon {
    transform: rotate(90deg);
  }
  .include h3 {
    font-size: var(--fs-h4);
    font-weight: 600;
  }
  .include p {
    color: var(--text-muted);
    line-height: 1.6;
  }
  @media (min-width: 720px) {
    .includes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .includes__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Especialidades */
  .specialties__list {
    margin-top: 28px;
  }
  .spec {
    display: grid;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }
  .spec__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .spec__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .spec:hover .spec__media :global(img) {
    transform: scale(1.05);
  }
  .spec__body {
    display: grid;
    align-content: center;
    gap: 20px;
    padding: clamp(28px, 5vw, 72px);
  }
  .spec__body h3 {
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .spec__body :global(em) {
    color: var(--green);
  }
  .spec__body p {
    color: var(--text-on-ink-muted);
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 36ch;
  }
  .spec__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--green);
  }
  .spec:hover .spec__cta :global(svg) {
    transform: translateX(4px);
  }
  .spec__cta :global(svg) {
    transition: transform 0.4s var(--ease-out);
  }
  @media (min-width: 900px) {
    .spec {
      grid-template-columns: 1fr 1.1fr;
    }
    .spec__media {
      aspect-ratio: auto;
      min-height: 460px;
    }
  }

  .back {
    padding-top: var(--section-s);
  }
  .back__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--paper-2);
    transition: background-color 0.3s;
  }
  .back__link:hover {
    background: var(--green);
  }
  .back__link :global(.back__icon) {
    transform: rotate(180deg);
  }

  /* Relacionados */
  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 40px;
  }
  .related__head .link {
    font-weight: 550;
  }
  .related__grid {
    display: grid;
    gap: 12px;
  }
  .card {
    position: relative;
    display: grid;
    height: 100%;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--paper-2);
    transition: background-color 0.4s;
  }
  .card:hover {
    background: var(--white);
  }
  .card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .card:hover .card__media :global(img) {
    transform: scale(1.06);
  }
  .card__body {
    display: grid;
    gap: 8px;
    padding: 24px 24px 28px;
  }
  .card__num {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--green-ink);
  }
  .card__body h3 {
    font-size: var(--fs-h4);
    font-weight: 600;
  }
  .card__body p {
    color: var(--text-muted);
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .card__arrow {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--paper);
    transition:
      background-color 0.4s,
      transform 0.6s var(--ease-out);
  }
  .card:hover .card__arrow {
    background: var(--green);
    transform: rotate(45deg);
  }
  @media (min-width: 900px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
