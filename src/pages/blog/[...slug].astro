---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/blog/${post.id}/`, site.url).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: post.data.author },
    publisher: { '@id': `${site.url}/#organizacion` },
    mainEntityOfPage: url,
    inLanguage: 'es-ES',
  },
];
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  eyebrow="Blog"
  lead={post.data.description}
  meta={`${date} · ${post.data.author}`}
  breadcrumbs={[{ label: 'Blog', href: '/blog/' }, { label: post.data.title, href: `/blog/${post.id}/` }]}
  services={post.data.services}
  schema={schema}
>
  <Content />
</ArticleLayout>
