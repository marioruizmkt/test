---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getService, serviceHref } from '@/data/services';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const href = `/blog/${post.id}/`;
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.data.title, href },
];
const related = post.data.services.map((s) => getService(s)).filter(Boolean);
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  url: new URL(href, site.url).href,
  inLanguage: 'es-ES',
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
};
---

<Base title={post.data.title} description={post.data.description} schema={[article, breadcrumbSchema(crumbs)]}>
  <article>
    <header class="p-hero container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="p-hero__date">
        <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
      </p>
      {
        post.data.cover && (
          <figure class="p-hero__cover">
            <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[800, 1280, 1920]} sizes="100vw" loading="eager" />
          </figure>
        )
      }
    </header>
    <div class="container p-body">
      <div class="prose">
        <Content />
      </div>
      {
        related.length > 0 && (
          <aside class="p-related" aria-label="Servicios relacionados">
            <p>Servicios relacionados</p>
            <ul role="list">
              {related.map((s) => (
                <li>
                  <a href={serviceHref(s!.slug)}>{s!.name}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
  <CtaBand />
</Base>

<style>
  .p-hero {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-top: calc(var(--header-h) + clamp(24px, 4vw, 56px));
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .p-hero h1 {
    max-width: 18ch;
  }
  .p-hero__date {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .p-hero__cover {
    width: 100%;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 16 / 8;
    margin-top: 16px;
  }
  .p-hero__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p-body {
    display: grid;
    gap: 48px;
    padding-bottom: var(--section-s);
  }
  .p-related p {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .p-related ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .p-related a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--paper-2);
    font-weight: 550;
  }
  @media (min-width: 1024px) {
    .p-body {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 80px;
    }
    .p-related {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }
</style>
